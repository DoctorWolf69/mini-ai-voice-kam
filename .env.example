# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: natural voice and accurate speech-to-text. Enable both "Text to Speech" and "Speech to Text"
# on the key. Without it the browser's own voice and speech recognition are used.
# Free-plan voices that work via API: Sarah EXAVITQu4vr4xnSDxMaL, Laura FGY2WhTYpPnrIDTdsKH5, George JBFqnCBsd6RMkjVDRZzb, Jessica cgSgspJ2msm6clMCkdW9
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Optional: claude-sonnet-5-5 for higher quality, slower turns
KAM_MODEL=claude-haiku-5-5

# Only for a public link: require ?code=... in the URL, listen on all interfaces, use the platform's port
ACCESS_CODE=
# HOST=0.0.0.0
# PORT=8000
